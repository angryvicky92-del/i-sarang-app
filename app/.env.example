# Supabase
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 관광 API (https://www.data.go.kr) - 절대 코드에 하드코딩 금지
EXPO_PUBLIC_TOURISM_API_KEY=your_tourism_api_key

# 날씨/대기 API
EXPO_PUBLIC_WEATHER_API_KEY=your_weather_api_key

# 어린이집 정보 공공데이터 API 인증키
EXPO_PUBLIC_CHILDCARE_API_KEY=your_childcare_api_key

# 카카오 REST API 키 (좌표->주소 변환용)
EXPO_PUBLIC_KAKAO_REST_API_KEY=your_kakao_rest_api_key
